{
  "servers": {
    "ai-foundry-joke-agent-stdio-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "stdio_mcp.py"
      ],
      "cwd": "${workspaceFolder}",
    },
    "ai-foundry-joke-agent-local-http-mcp": {
      "url": "http://localhost:7071/mcp",
      "type": "http"
    },
    "ai-foundry-joke-agent-remote-mcp": {
      "type": "http",
      "url": "https://${input:functions-name}.azurewebsites.net/mcp",
      "headers": {
        "x-functions-key": "${input:functions-key}"
      }
    },
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "functions-key",
      "description": "Functions App Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "functions-name",
      "description": "Functions App Name",
      "password": false
    }
  ]
}